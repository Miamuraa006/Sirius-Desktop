{
  "skill": "applications",
  "rules": [
    {
      "action": "open_app",
      "parameters": {"app": "cs2"},
      "patterns": [
        "(?:(?:включи|включить) )?(?:игровой режим|режим (?:игры|реградаций|реградации|деградации)|(?:ка ?[еэ]с|к ?с) (?:два|2)|кс2|cs2|counter[ -]strike(?: 2)?|(?:контр|каунтер) страйк(?: два)?)"
      ],
      "examples": ["режим игры", "игровой режим", "включи игровой режим", "режим реградаций", "каэс два", "каес два", "каес 2", "CS2"]
    },
    {
      "action": "open_app",
      "patterns": [
        "(?:открой|открывай|открыть|запусти|запускай|запустить)(?: приложение| программу)? (?P<app>[^\\r\\n\"]+)"
      ],
      "parameters": {},
      "examples": [
        "открой калькулятор",
        "запусти блокнот",
        "открой проводник",
        "открой браузер",
        "открыть приложение редактор",
        "открой стим",
        "открывай Steam",
        "запусти телеграм",
        "открой ютуб"
      ]
    },
    {
      "action": "close_app",
      "patterns": [
        "(?:закрой|закрыть)(?: приложение| программу)? (?P<app>[^\\r\\n\"]+)"
      ],
      "parameters": {},
      "examples": [
        "закрой блокнот",
        "закрой его",
        "закрыть последнюю программу"
      ]
    },
    {
      "action": "status",
      "patterns": [
        "(?:запущен ли|запущено ли|работает ли|проверь(?: приложение)?|статус(?: приложения)?) (?P<app>[^\\r\\n\"]+)"
      ],
      "parameters": {},
      "examples": [
        "запущен ли блокнот",
        "проверь приложение калькулятор",
        "статус браузер"
      ]
    },
    {
      "action": "restart",
      "patterns": [
        "(?:перезапусти|перезапустить)(?: приложение| программу)? (?P<app>[^\\r\\n\"]+)"
      ],
      "parameters": {},
      "examples": [
        "перезапусти блокнот",
        "перезапустить его"
      ]
    },
    {
      "action": "focus_app",
      "patterns": [
        "(?:переключись на|переключиться на|активируй)(?: приложение| программу)? (?P<app>[^\\r\\n\"]+)"
      ],
      "parameters": {},
      "examples": [
        "переключись на Telegram",
        "активируй стим"
      ]
    },
    {
      "action": "list",
      "parameters": {},
      "patterns": [
        "что открыто|покажи открытые (?:приложения|окна)"
      ],
      "examples": [
        "что открыто"
      ]
    },
    {
      "action": "list",
      "parameters": {
        "surface": "taskbar"
      },
      "patterns": [
        "что на панели задач|покажи панель задач"
      ],
      "examples": [
        "что на панели задач"
      ]
    },
    {
      "action": "list",
      "parameters": {
        "surface": "tray"
      },
      "patterns": [
        "что в трее|покажи трей"
      ],
      "examples": [
        "что в трее"
      ]
    },
    {
      "action": "list",
      "parameters": {
        "surface": "installed"
      },
      "patterns": [
        "(?:покажи|список) установленные программы|список установленных программ"
      ],
      "examples": [
        "покажи установленные программы"
      ]
    }
  ]
}
