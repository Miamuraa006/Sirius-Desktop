{
  "skill": "system_monitor",
  "rules": [
    {
      "action": "cpu",
      "patterns": [
        "(?:покажи |назови )?(?:загрузку|загрузка) (?:процессора|cpu)|процессор"
      ],
      "parameters": {},
      "examples": [
        "загрузка CPU",
        "покажи загрузку процессора"
      ]
    },
    {
      "action": "ram",
      "patterns": [
        "(?:покажи |назови )?(?:занятость|использование|загрузка) (?:оперативной памяти|ram)|оперативная память"
      ],
      "parameters": {},
      "examples": [
        "занятость RAM",
        "покажи использование оперативной памяти"
      ]
    },
    {
      "action": "disk",
      "patterns": [
        "(?:покажи |назови )?свободное место(?: на диске| диска)?|сколько места на диске"
      ],
      "parameters": {},
      "examples": [
        "свободное место на диске",
        "сколько места на диске"
      ]
    },
    {
      "action": "battery",
      "patterns": [
        "(?:покажи |назови )?заряд (?:батареи|аккумулятора)|батарея"
      ],
      "parameters": {},
      "examples": [
        "заряд батареи",
        "покажи заряд аккумулятора"
      ]
    },
    {
      "action": "temperature",
      "patterns": [
        "(?:покажи |назови )?температур(?:а|у)(?: процессора| датчиков)?"
      ],
      "parameters": {},
      "examples": [
        "температура",
        "покажи температуру процессора"
      ]
    }
  ]
}
