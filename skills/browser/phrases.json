{
  "skill": "browser",
  "rules": [
    {
      "action": "open",
      "patterns": [
        "(?:открой|открыть) (?:сайт|ссылку|url) (?P<url>\\S+)",
        "(?:открой|открыть) (?P<url>https?://\\S+)"
      ],
      "parameters": {},
      "examples": [
        "открой сайт https://example.com/Case",
        "открыть ссылку example.org",
        "открой https://example.org"
      ]
    },
    {
      "action": "search",
      "patterns": [
        "(?:найди|найти|поищи|поиск|поискать) в интернете (?P<query>.+)"
      ],
      "parameters": {},
      "examples": [
        "найди в интернете C++: API",
        "поиск в интернете погода Баку",
        "поищи в интернете погода"
      ]
    },
    {
      "action": "new_tab",
      "patterns": [
        "новая вкладка|(?:открой|открыть|создай|создать) (?:новую )?вкладку"
      ],
      "parameters": {},
      "examples": [
        "новая вкладка",
        "открой новую вкладку",
        "создать вкладку"
      ]
    },
    {
      "action": "close_tab",
      "patterns": [
        "(?:закрой|закрыть) (?:текущую )?вкладку"
      ],
      "parameters": {},
      "examples": [
        "закрой вкладку",
        "закрыть текущую вкладку"
      ]
    },
    {
      "action": "refresh",
      "patterns": [
        "обнови(?: страницу| вкладку)?|обновить(?: страницу| вкладку)?"
      ],
      "parameters": {},
      "examples": [
        "обнови страницу",
        "обнови",
        "обновить вкладку"
      ]
    },
    {
      "action": "back",
      "patterns": [
        "(?:перейди|перейти) назад|назад в браузере"
      ],
      "parameters": {},
      "examples": [
        "перейди назад",
        "назад в браузере"
      ]
    },
    {
      "action": "forward",
      "patterns": [
        "(?:перейди|перейти) вперёд|вперёд в браузере"
      ],
      "parameters": {},
      "examples": [
        "перейди вперёд",
        "вперёд в браузере"
      ]
    },
    {
      "action": "next_tab",
      "parameters": {},
      "patterns": [
        "(?:следующая|следующую) вкладк[ау]|(?:перейди|переключись) на следующую вкладку"
      ],
      "examples": [
        "следующая вкладка"
      ]
    },
    {
      "action": "previous_tab",
      "parameters": {},
      "patterns": [
        "предыдущ(?:ая|ую) вкладк[ау]|(?:перейди|переключись) на предыдущую вкладку"
      ],
      "examples": [
        "предыдущая вкладка"
      ]
    },
    {
      "action": "reopen_tab",
      "parameters": {},
      "patterns": [
        "(?:верни|восстанови) (?:последнюю )?закрытую вкладку"
      ],
      "examples": [
        "верни закрытую вкладку"
      ]
    }
  ]
}
