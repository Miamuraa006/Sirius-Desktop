{
  "skill": "windows",
  "rules": [
    {
      "action": "minimize",
      "patterns": [
        "(?:сверни|свернуть)(?: активное)? окно"
      ],
      "parameters": {},
      "examples": [
        "сверни окно",
        "свернуть активное окно"
      ]
    },
    {
      "action": "maximize",
      "patterns": [
        "(?:разверни|развернуть)(?: активное)? окно"
      ],
      "parameters": {},
      "examples": [
        "разверни окно",
        "развернуть активное окно"
      ]
    },
    {
      "action": "restore",
      "patterns": [
        "(?:восстанови|восстановить)(?: активное)? окно"
      ],
      "parameters": {},
      "examples": [
        "восстанови окно",
        "восстановить активное окно"
      ]
    },
    {
      "action": "switch",
      "patterns": [
        "(?:переключи|переключить) окно|следующее окно"
      ],
      "parameters": {},
      "examples": [
        "переключи окно",
        "следующее окно"
      ]
    },
    {
      "action": "desktop",
      "patterns": [
        "(?:покажи|показать|открой|открыть) рабочий стол|сверни все окна"
      ],
      "parameters": {},
      "examples": [
        "покажи рабочий стол",
        "сверни все окна"
      ]
    },
    {
      "action": "activate",
      "patterns": [
        "(?:активируй|активировать) окно (?P<target>[^\\r\\n]+)"
      ],
      "parameters": {},
      "examples": [
        "активируй окно блокнот",
        "активировать окно Calculator"
      ]
    }
  ]
}
