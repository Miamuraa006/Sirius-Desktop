{
  "skill": "media",
  "rules": [
    {
      "action": "pause",
      "patterns": [
        "пауза|паузу|(?:поставь|поставить)(?: музыку| трек| песню| видео| воспроизведение)? (?:на )?паузу|(?:приостанови|приостановить)(?: музыку| воспроизведение| видео)?"
      ],
      "parameters": {},
      "examples": [
        "пауза",
        "поставь паузу",
        "поставь музыку на паузу",
        "поставь видео на паузу"
      ]
    },
    {
      "action": "play",
      "patterns": [
        "(?:включи|включить|поставь) (?:музыку|воспроизведение|видео)|(?:продолжи|продолжить|возобнови|возобновить)(?: музыку| воспроизведение| видео)?"
      ],
      "parameters": {},
      "examples": [
        "продолжи",
        "включи музыку",
        "продолжить воспроизведение"
      ]
    },
    {
      "action": "play_pause",
      "patterns": [
        "play pause|переключи паузу"
      ],
      "parameters": {},
      "examples": [
        "play pause",
        "переключи паузу"
      ]
    },
    {
      "action": "next",
      "patterns": [
        "(?:(?:включи|включить|переключи|переключить)(?: на)? )?следующ(?:ий|ая|ую|ее)(?: трек| песня| песню| музыка| музыку| видео)?|пропусти(?: трек| песню| музыку| видео)?"
      ],
      "parameters": {},
      "examples": [
        "следующий трек",
        "следующая",
        "следующее",
        "следующая музыка",
        "пропусти трек"
      ]
    },
    {
      "action": "previous",
      "patterns": [
        "(?:(?:включи|включить|переключи|переключить)(?: на)? )?предыдущ(?:ий|ая|ую|ее)(?: трек| песня| песню| музыка| музыку| видео)?"
      ],
      "parameters": {},
      "examples": [
        "предыдущий трек",
        "предыдущая",
        "предыдущая музыка"
      ]
    },
    {
      "action": "stop",
      "patterns": [
        "стоп(?: музыка)?|(?:останови|остановить|выключи|выключить) (?:музыку|воспроизведение|видео)"
      ],
      "parameters": {},
      "examples": [
        "стоп",
        "останови музыку",
        "выключи музыку"
      ]
    },
    {
      "action": "play",
      "parameters": {
        "player": "youtube"
      },
      "patterns": [
        "(?:включи|продолжи|запусти) (?:видео|воспроизведение|музыку) на (?:ютубе|youtube)"
      ],
      "examples": [
        "включи видео на ютубе"
      ]
    },
    {
      "action": "play",
      "parameters": {
        "player": "yandex_music"
      },
      "patterns": [
        "(?:включи|продолжи|запусти) (?:музыку|трек|воспроизведение) в (?:яндекс[ .]музыке|yandex music)"
      ],
      "examples": [
        "включи музыку в яндекс музыке"
      ]
    },
    {
      "action": "previous",
      "parameters": {
        "history_if_youtube": true
      },
      "patterns": [
        "назад"
      ],
      "examples": [
        "назад"
      ]
    }
  ]
}
