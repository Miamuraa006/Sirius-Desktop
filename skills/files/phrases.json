{
  "skill": "files",
  "rules": [
    {
      "action": "mkdir",
      "patterns": [
        "(?:создай|создать) (?:папку|каталог) \"(?P<path>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "создай папку \"Мои файлы\"",
        "создать каталог \"Новый\""
      ]
    },
    {
      "action": "touch",
      "patterns": [
        "(?:создай|создать) (?:пустой )?(?:файл|txt(?: файл)?) \"(?P<path>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "создай пустой txt \"Заметки.txt\"",
        "создать файл \"Example.txt\""
      ]
    },
    {
      "action": "open",
      "patterns": [
        "(?:открой|открыть)(?: файл| папку)? \"(?P<path>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "открой файл \"Заметки.txt\"",
        "открыть папку \"Мои файлы\""
      ]
    },
    {
      "action": "rename",
      "patterns": [
        "(?:переименуй|переименовать)(?: файл| папку)? \"(?P<path>[^\"\\r\\n]+)\" в \"(?P<destination>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "переименуй \"My A.txt\" в \"My B.txt\"",
        "переименовать папку \"A\" в \"B\""
      ]
    },
    {
      "action": "move",
      "patterns": [
        "(?:перемести|переместить)(?: файл| папку)? \"(?P<path>[^\"\\r\\n]+)\" в \"(?P<destination>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "перемести \"A.txt\" в \"Sub/A.txt\"",
        "переместить папку \"A\" в \"Sub/B\""
      ]
    },
    {
      "action": "trash",
      "patterns": [
        "(?:удали|удалить)(?: файл| папку)? \"(?P<path>[^\"\\r\\n]+)\"(?: в корзину)?",
        "(?:отправь|отправить) в корзину \"(?P<path>[^\"\\r\\n]+)\""
      ],
      "parameters": {},
      "examples": [
        "удали \"A.txt\" в корзину",
        "отправь в корзину \"B.txt\""
      ]
    }
  ]
}
