{
  "skill": "brightness",
  "rules": [
    {
      "action": "set",
      "patterns": [
        "(?:яркость|(?:установи|установить|поставь|сделай) яркость)(?: на)? (?P<value>-?\\d+)(?: ?%| процент(?:а|ов)?)?"
      ],
      "parameters": {},
      "examples": [
        "яркость 70",
        "яркость на 70%",
        "установи яркость на семьдесят процентов",
        "яркость 23 процента"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "(?:сделай |сделать )?ярче"
      ],
      "parameters": {
        "delta": 20
      },
      "examples": [
        "ярче",
        "сделай ярче"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "(?:сделай |сделать )?темнее"
      ],
      "parameters": {
        "delta": -20
      },
      "examples": [
        "темнее",
        "сделай темнее"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "ещё ярче"
      ],
      "parameters": {
        "delta": 10
      },
      "examples": [
        "ещё ярче",
        "еще ярче"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "ещё темнее"
      ],
      "parameters": {
        "delta": -10
      },
      "examples": [
        "ещё темнее",
        "еще темнее"
      ]
    },
    {
      "action": "set",
      "patterns": [
        "(?:яркость(?: на)? максимум|максимальная яркость|(?:установи|поставь) яркость на максимум)"
      ],
      "parameters": {
        "value": 100
      },
      "examples": [
        "яркость на максимум",
        "максимальная яркость"
      ]
    },
    {
      "action": "set",
      "patterns": [
        "(?:яркость(?: на)? минимум|минимальная яркость|(?:установи|поставь) яркость на минимум)"
      ],
      "parameters": {
        "value": 0
      },
      "examples": [
        "яркость на минимум",
        "минимальная яркость"
      ]
    }
  ]
}
