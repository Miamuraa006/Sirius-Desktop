{
  "skill": "volume",
  "rules": [
    {
      "action": "set",
      "patterns": [
        "(?:громкость|(?:установи|установить|поставь|сделай) громкость)(?: на)? (?P<value>-?\\d+)(?: ?%| процент(?:а|ов)?)?"
      ],
      "parameters": {},
      "examples": [
        "громкость 70",
        "громкость на 70%",
        "установи громкость на семьдесят процентов",
        "громкость 23 процента"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "(?:сделай |сделать )?громче"
      ],
      "parameters": {
        "delta": 20
      },
      "examples": [
        "громче",
        "сделай громче"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "(?:сделай |сделать )?тише"
      ],
      "parameters": {
        "delta": -20
      },
      "examples": [
        "тише",
        "сделай тише"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "ещё громче"
      ],
      "parameters": {
        "delta": 10
      },
      "examples": [
        "ещё громче",
        "еще громче"
      ]
    },
    {
      "action": "adjust",
      "patterns": [
        "ещё тише"
      ],
      "parameters": {
        "delta": -10
      },
      "examples": [
        "ещё тише",
        "еще тише"
      ]
    },
    {
      "action": "set",
      "patterns": [
        "(?:громкость(?: на)? максимум|максимальная громкость|(?:установи|поставь) громкость на максимум)"
      ],
      "parameters": {
        "value": 100
      },
      "examples": [
        "громкость на максимум",
        "максимальная громкость"
      ]
    },
    {
      "action": "set",
      "patterns": [
        "(?:громкость(?: на)? минимум|минимальная громкость|(?:установи|поставь) громкость на минимум)"
      ],
      "parameters": {
        "value": 0
      },
      "examples": [
        "громкость на минимум",
        "минимальная громкость"
      ]
    },
    {
      "action": "mute",
      "patterns": [
        "(?:выключи|выключить|отключи|отключить) звук|без звука|mute"
      ],
      "parameters": {},
      "examples": [
        "выключи звук",
        "без звука",
        "mute"
      ]
    },
    {
      "action": "unmute",
      "patterns": [
        "(?:включи|включить|верни|вернуть) звук|unmute"
      ],
      "parameters": {},
      "examples": [
        "включи звук",
        "верни звук",
        "unmute"
      ]
    }
  ]
}
