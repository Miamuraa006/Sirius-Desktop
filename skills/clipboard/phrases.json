{
  "skill": "clipboard",
  "rules": [
    {
      "action": "status",
      "patterns": [
        "(?:проверь|проверить|прочитай|прочитать) буфер обмена|есть ли текст в буфере|статус буфера обмена"
      ],
      "parameters": {},
      "examples": [
        "проверь буфер обмена",
        "есть ли текст в буфере",
        "прочитай буфер обмена"
      ]
    },
    {
      "action": "copy",
      "patterns": [
        "(?:скопируй|скопировать|копировать)(?: выделенное| выделенный текст)?"
      ],
      "parameters": {},
      "examples": [
        "скопируй выделенное",
        "копировать",
        "скопировать выделенный текст"
      ]
    },
    {
      "action": "paste",
      "patterns": [
        "(?:вставь|вставить)(?: из буфера(?: обмена)?)?"
      ],
      "parameters": {},
      "examples": [
        "вставь",
        "вставить из буфера обмена"
      ]
    },
    {
      "action": "select_all",
      "patterns": [
        "(?:выдели|выделить) всё"
      ],
      "parameters": {},
      "examples": [
        "выдели всё",
        "выделить все"
      ]
    },
    {
      "action": "set",
      "patterns": [
        "(?:установи(?:ть)? буфер обмена|запиши в буфер(?: обмена)?|скопируй текст) (?P<text>.+)"
      ],
      "parameters": {},
      "examples": [
        "установи буфер обмена MiXeD Ёж",
        "запиши в буфер обмена A  B",
        "скопируй текст Не Менять Регистр"
      ]
    }
  ]
}
