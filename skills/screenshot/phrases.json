{
  "skill": "screenshot",
  "rules": [
    {
      "action": "full",
      "patterns": [
        "скриншот|(?:сделай|сделать) (?:скриншот|снимок)(?: всего экрана| экрана)?|снимок всего экрана"
      ],
      "parameters": {},
      "examples": [
        "скриншот",
        "сделай снимок всего экрана",
        "сделать скриншот"
      ]
    },
    {
      "action": "window",
      "patterns": [
        "(?:сделай |сделать )?(?:скриншот|снимок) (?:активного )?окна"
      ],
      "parameters": {},
      "examples": [
        "снимок активного окна",
        "сделай скриншот окна"
      ]
    }
  ]
}
